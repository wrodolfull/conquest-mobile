{
  "name": "conquest-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "rm -rf .test-dist && tsc src/types/native-modules.d.ts src/features/activity/tracking.ts src/features/activity/outdoorRules.ts src/features/territories/territoryGrid.ts src/features/poi/config.ts src/features/poi/types.ts src/features/poi/geofenceEngine.ts src/features/poi/poiRules.ts src/features/poi/arenaRanking.ts --outDir .test-dist --module commonjs --target es2022 --skipLibCheck && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.7",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.9",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
